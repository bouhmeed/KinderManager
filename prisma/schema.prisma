generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                         Int                       @id @default(autoincrement())
  name                       String
  email                      String                    @unique
  passwordHash               String
  role                       UserRole
  isActive                   Boolean                   @default(true)
  declaredAbsences           AbsenceDeclaration[]
  recordedAttendances        Attendance[]              @relation("AttendanceRecorder")
  confirmedChecklistItems    ChildChecklistItem[]      @relation("ChecklistItemReceiver")
  createdChildNotes          ChildNote[]
  conversationParticipants   ConversationParticipant[]
  educatorProfile            EducatorProfile?
  guardianProfile            Guardian?
  createdIncidents           Incident[]
  reportedLostItems          LostItemReport[]
  sentMessages               Message[]
  notifications              Notification[]
  createdObservations        Observation[]
  publishedPhotos            Photo[]
  createdPickupNotifications PickupNotification[]
  createdRequests            Request[]
  createdEmergencyContacts   EmergencyContact[]
  createdAllergies           Allergy[]
  createdFoodRestrictions    FoodRestriction[]
  createdPickupPeople        AuthorizedPickupPerson[]
  createdParentInstructions  ParentInstruction[]
  sessions                   Session[]                 @relation("UserSessions")
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation("UserSessions", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EducatorProfile {
  id          Int                  @id @default(autoincrement())
  userId      Int                  @unique
  phone       String
  user        User                 @relation(fields: [userId], references: [id])
  classRooms  EducatorClassRoom[]
}

model EducatorClassRoom {
  id          Int            @id @default(autoincrement())
  educatorId  Int
  classRoomId Int
  educator    EducatorProfile @relation(fields: [educatorId], references: [id])
  classRoom   ClassRoom      @relation(fields: [classRoomId], references: [id])

  @@unique([educatorId, classRoomId])
  @@index([classRoomId])
}

model Guardian {
  id        Int             @id @default(autoincrement())
  firstName String
  lastName  String
  phone     String
  email     String?
  userId    Int?            @unique
  children  ChildGuardian[]
  user      User?           @relation(fields: [userId], references: [id])
}

model ChildGuardian {
  id               Int      @id @default(autoincrement())
  childId          Int
  guardianId       Int
  isLegalGuardian  Boolean  @default(false)
  isPrimaryContact Boolean  @default(false)
  relationshipType String
  guardian         Guardian @relation(fields: [guardianId], references: [id])
  child            Child    @relation(fields: [childId], references: [id])

  @@unique([childId, guardianId])
}

model Child {
  id                     Int                      @id @default(autoincrement())
  firstName              String
  lastName               String
  birthDate              DateTime
  photo                  String?
  enrollmentStatus       String
  classRoomId            Int?
  allergies              Allergy[]
  attendances            Attendance[]
  authorizedPickupPeople AuthorizedPickupPerson[]
  classRoom              ClassRoom?               @relation(fields: [classRoomId], references: [id])
  checklistItems         ChildChecklistItem[]
  guardians              ChildGuardian[]
  notes                  ChildNote[]
  observations           ChildObservation[]
  subscriptions          ChildSubscription[]
  conversations          Conversation[]
  emergencyContacts      EmergencyContact[]
  foodRestrictions       FoodRestriction[]
  incidents              Incident[]
  insuranceRecords       InsuranceRecord[]
  invoices               Invoice[]
  lostItemReports        LostItemReport[]
  parentInstructions     ParentInstruction[]
  photos                 Photo[]
  pickupNotifications    PickupNotification[]
  requests               Request[]
}

model ClassRoom {
  id         Int               @id @default(autoincrement())
  name       String
  ageGroup   Int
  capacity   Int
  children   Child[]
  activities ClassActivity[]
  photos     Photo[]
  educators  EducatorClassRoom[]
}

model Attendance {
  id                 Int                 @id @default(autoincrement())
  childId            Int
  date               DateTime
  status             AttendanceStatus
  arrivalTime        DateTime?
  departureTime      DateTime?
  recordedBy         Int
  absenceDeclaration AbsenceDeclaration?
  recorder           User                @relation("AttendanceRecorder", fields: [recordedBy], references: [id])
  child              Child               @relation(fields: [childId], references: [id])

  @@unique([childId, date])
}

model AbsenceDeclaration {
  id                 Int               @id @default(autoincrement())
  attendanceId       Int               @unique
  reason             String?
  description        String?
  declaredByUserId   Int
  source             DeclarationSource
  status             String            @default("PENDING")
  expectedReturnDate DateTime?
  declaredBy         User              @relation(fields: [declaredByUserId], references: [id])
  attendance         Attendance        @relation(fields: [attendanceId], references: [id])
}

model RegistrationChecklist {
  id       Int             @id @default(autoincrement())
  name     String
  ageGroup Int
  isActive Boolean         @default(true)
  items    ChecklistItem[]
}

model ChecklistItem {
  id          Int                   @id @default(autoincrement())
  checklistId Int
  name        String
  isRequired  Boolean               @default(true)
  checklist   RegistrationChecklist @relation(fields: [checklistId], references: [id])
  childItems  ChildChecklistItem[]
}

model ChildChecklistItem {
  id         Int           @id @default(autoincrement())
  childId    Int
  itemId     Int
  isReceived Boolean       @default(false)
  receivedAt DateTime?
  receivedBy Int?
  receiver   User?         @relation("ChecklistItemReceiver", fields: [receivedBy], references: [id])
  item       ChecklistItem @relation(fields: [itemId], references: [id])
  child      Child         @relation(fields: [childId], references: [id])

  @@unique([childId, itemId])
}

model Conversation {
  id           Int                       @id @default(autoincrement())
  childId      Int?
  createdAt    DateTime                  @default(now())
  child        Child?                    @relation(fields: [childId], references: [id])
  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             Int          @id @default(autoincrement())
  conversationId Int
  userId         Int
  user           User         @relation(fields: [userId], references: [id])
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  @@unique([conversationId, userId])
}

model Message {
  id             Int          @id @default(autoincrement())
  conversationId Int
  senderId       Int
  content        String
  sentAt         DateTime     @default(now())
  isRead         Boolean      @default(false)
  sender         User         @relation(fields: [senderId], references: [id])
  conversation   Conversation @relation(fields: [conversationId], references: [id])
}

model Request {
  id          Int      @id @default(autoincrement())
  childId     Int?
  createdBy   Int
  type        String
  description String
  status      String
  createdAt   DateTime @default(now())
  creator     User     @relation(fields: [createdBy], references: [id])
  child       Child?   @relation(fields: [childId], references: [id])
}

model Announcement {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  createdAt DateTime @default(now())
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  message   String
  status    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model Activity {
  id              Int             @id @default(autoincrement())
  title           String
  description     String
  category        String
  date            DateTime
  classActivities ClassActivity[]
}

model ClassActivity {
  id         Int       @id @default(autoincrement())
  activityId Int
  classId    Int
  classRoom  ClassRoom @relation(fields: [classId], references: [id])
  activity   Activity  @relation(fields: [activityId], references: [id])

  @@unique([activityId, classId])
}

model Observation {
  id          Int                @id @default(autoincrement())
  title       String
  description String
  createdBy   Int
  createdAt   DateTime           @default(now())
  children    ChildObservation[]
  creator     User               @relation(fields: [createdBy], references: [id])
}

model ChildObservation {
  id                 Int         @id @default(autoincrement())
  observationId      Int
  childId            Int
  isSharedWithParent Boolean     @default(false)
  child              Child       @relation(fields: [childId], references: [id])
  observation        Observation @relation(fields: [observationId], references: [id])

  @@unique([observationId, childId])
}

model ChildNote {
  id             Int     @id @default(autoincrement())
  childId        Int
  createdBy      Int
  content        String
  isConfidential Boolean @default(false)
  creator        User    @relation(fields: [createdBy], references: [id])
  child          Child   @relation(fields: [childId], references: [id])
}

model EmergencyContact {
  id           Int    @id @default(autoincrement())
  childId      Int
  name         String
  relationship String
  phone        String
  createdBy    Int?
  creator      User?  @relation(fields: [createdBy], references: [id])
  child        Child  @relation(fields: [childId], references: [id])
}

model Allergy {
  id          Int    @id @default(autoincrement())
  childId     Int
  description String
  severity    String
  createdBy   Int?
  creator     User?  @relation(fields: [createdBy], references: [id])
  child       Child  @relation(fields: [childId], references: [id])
}

model FoodRestriction {
  id          Int    @id @default(autoincrement())
  childId     Int
  description String
  createdBy   Int?
  creator     User?  @relation(fields: [createdBy], references: [id])
  child       Child  @relation(fields: [childId], references: [id])
}

model Incident {
  id             Int      @id @default(autoincrement())
  childId        Int
  description    String
  actionTaken    String
  parentInformed Boolean
  createdAt      DateTime @default(now())
  createdBy      Int
  creator        User     @relation(fields: [createdBy], references: [id])
  child          Child    @relation(fields: [childId], references: [id])
}

model ParentInstruction {
  id        Int      @id @default(autoincrement())
  childId   Int
  content   String
  createdAt DateTime @default(now())
  createdBy Int?
  creator   User?    @relation(fields: [createdBy], references: [id])
  child     Child    @relation(fields: [childId], references: [id])
}

model AuthorizedPickupPerson {
  id           Int    @id @default(autoincrement())
  childId      Int
  name         String
  relationship String
  phone        String
  createdBy    Int?
  creator      User?  @relation(fields: [createdBy], references: [id])
  child        Child  @relation(fields: [childId], references: [id])
}

model PickupNotification {
  id         Int      @id @default(autoincrement())
  childId    Int
  personName String
  pickupDate DateTime
  createdBy  Int
  creator    User     @relation(fields: [createdBy], references: [id])
  child      Child    @relation(fields: [childId], references: [id])
}

model SubscriptionPlan {
  id        Int                 @id @default(autoincrement())
  name      String
  startTime String
  endTime   String
  price     Decimal
  children  ChildSubscription[]
}

model ChildSubscription {
  id          Int              @id @default(autoincrement())
  childId     Int
  planId      Int
  agreedPrice Decimal
  startDate   DateTime
  endDate     DateTime?
  plan        SubscriptionPlan @relation(fields: [planId], references: [id])
  child       Child            @relation(fields: [childId], references: [id])
}

model Invoice {
  id          Int           @id @default(autoincrement())
  childId     Int
  totalAmount Decimal
  status      String
  issueDate   DateTime
  dueDate     DateTime?
  child       Child         @relation(fields: [childId], references: [id])
  items       InvoiceItem[]
  payments    Payment[]
}

model InvoiceItem {
  id          Int     @id @default(autoincrement())
  invoiceId   Int
  description String
  quantity    Int
  unitPrice   Decimal
  total       Decimal
  invoice     Invoice @relation(fields: [invoiceId], references: [id])
}

model Payment {
  id          Int      @id @default(autoincrement())
  invoiceId   Int
  amount      Decimal
  paymentDate DateTime
  method      String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id])
}

model InsuranceRecord {
  id        Int      @id @default(autoincrement())
  childId   Int
  provider  String
  reference String
  startDate DateTime
  endDate   DateTime
  status    String
  child     Child    @relation(fields: [childId], references: [id])
}

model Event {
  id          Int                     @id @default(autoincrement())
  title       String
  description String
  eventDate   DateTime
  price       Decimal
  providers   EventExternalProvider[]
}

model ExternalProvider {
  id      Int                     @id @default(autoincrement())
  name    String
  service String
  phone   String
  events  EventExternalProvider[]
}

model EventExternalProvider {
  eventId    Int
  providerId Int
  provider   ExternalProvider @relation(fields: [providerId], references: [id])
  event      Event            @relation(fields: [eventId], references: [id])

  @@id([eventId, providerId])
}

model Photo {
  id         Int        @id @default(autoincrement())
  childId    Int?
  classId    Int?
  filePath   String
  uploadedBy Int
  createdAt  DateTime   @default(now())
  uploader   User       @relation(fields: [uploadedBy], references: [id])
  classRoom  ClassRoom? @relation(fields: [classId], references: [id])
  child      Child?     @relation(fields: [childId], references: [id])
}

model FoundObject {
  id          Int      @id @default(autoincrement())
  description String
  category    String
  photo       String?
  foundDate   DateTime
  status      String
}

model LostItemReport {
  id          Int      @id @default(autoincrement())
  childId     Int
  description String
  category    String
  reportedAt  DateTime @default(now())
  status      String
  reportedBy  Int
  reporter    User     @relation(fields: [reportedBy], references: [id])
  child       Child    @relation(fields: [childId], references: [id])
}

enum UserRole {
  ADMIN
  EDUCATOR
  PARENT
}

enum AttendanceStatus {
  PRESENT
  ABSENT_DECLARED
  ABSENT_UNEXCUSED
  LATE
}

enum DeclarationSource {
  PARENT
  STAFF
}
